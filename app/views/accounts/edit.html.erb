<div class="w-min mx-auto">
  <h2 class="text-3xl mt-4">Edit account</h2>

  <%= form_with model: @user, url: account_path, method: :patch do |f| %>
    <% if @user.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:</h2>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, required: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= f.label :password, "New password" %> <i>(leave blank if you don't want to change it)</i><br />
      <%= f.password_field :password, autocomplete: "new-password" %>
      <br /><em>6 characters minimum</em>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm new password" %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :password_challenge, "Current password" %> <i>(we need your current password to confirm your changes)</i><br />
      <%= f.password_field :password_challenge, required: true, autocomplete: "current-password" %>
    </div>

    <div class="actions mt-2">
      <%= f.submit "Update", class: "btn-primary" %>
    </div>
  <% end %>

  <%= link_to "Back", root_path %>
</div>
