# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# All secrets live in one 1Password item, fetched with the 1Password CLI (`op`) at deploy time.
#   Account: my.1password.com  (your sign-in address; run `op account list` to check)
#   Item:    Personal/taskapp  (vault/item; fields named exactly as below)
SECRETS=$(kamal secrets fetch --adapter 1password --account my.1password.com --from Personal/taskapp KAMAL_REGISTRY_USERNAME KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE)

# Docker Hub credentials (password = a Docker Hub access token, not your login password)
KAMAL_REGISTRY_USERNAME=$(kamal secrets extract KAMAL_REGISTRY_USERNAME $SECRETS)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)

# Rails secret used to sign sessions/cookies. The app doesn't use Rails credentials,
# so no RAILS_MASTER_KEY is needed.
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
